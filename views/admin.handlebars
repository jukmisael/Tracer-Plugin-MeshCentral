<html>
<head>
<meta charset="utf-8">
<title>User Tracer</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Trebuchet MS",Arial,Helvetica,sans-serif;background:#d3d9d6;color:#000;padding:12px;font-size:13px;line-height:1.35}
.header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.header h1{font-size:18px;font-weight:700;color:#003366}.header .sub{color:#444;font-size:12px;margin-top:2px}
.stats{display:flex;gap:6px;flex-wrap:wrap}
.stat{background:#fff;border:1px solid #aaa;border-radius:3px;padding:8px 12px;min-width:88px}
.stat .n{font-size:18px;font-weight:700;color:#003366}.stat .l{font-size:10px;color:#666;text-transform:uppercase;margin-top:1px}
.panel{background:#fff;border:1px solid #aaa;border-radius:3px;padding:10px;margin-bottom:10px}
.panel-title{background:#c0c0c0;color:#000;font-size:12px;font-weight:700;padding:5px 8px;margin:-10px -10px 10px -10px;border-bottom:1px solid #aaa}
.toolbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.toolbar label{font-size:11px;color:#444;font-weight:700}
.toolbar select,.toolbar input{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px}
.btn{font-family:inherit;font-size:12px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:5px 12px;border-radius:2px;cursor:pointer}
.btn:hover{background:#e4e4e4}.btn-primary{background:#003366;color:#fff;border-color:#002244}
.btn-primary:hover{background:#004080}
.btn-sm{font-family:inherit;font-size:11px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:3px 8px;border-radius:2px;cursor:pointer}
.btn-sm:hover{background:#e4e4e4}
.tbsep{display:inline-block;width:1px;height:20px;background:#bbb;margin:0 6px}
.devlabel{font-size:11px;color:#444;font-weight:700;margin-right:2px}
.devsearch{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px;width:140px}

.sd-wrap{position:relative;flex:1}
.sd-sel{width:100%;box-sizing:border-box;border:1px solid #808080;background:#fff;color:#000;padding:4px 20px 4px 6px;border-radius:2px;cursor:pointer;font-size:12px;font-family:inherit;min-height:22px;outline:none}
.sd-sel[readonly]{cursor:pointer}
.sd-drop{display:none;position:absolute;top:100%;left:0;right:0;z-index:1000;background:#fff;border:1px solid #808080;border-top:none;border-radius:0 0 2px 2px;box-shadow:0 2px 6px rgba(0,0,0,.15)}
.sd-opts{max-height:240px;overflow-y:auto}
.sd-opt{padding:4px 6px;cursor:pointer;font-size:12px;font-family:inherit}
.sd-opt:hover{background:#e8f0fe}

.loading{text-align:center;padding:28px;color:#666}.muted{color:#666;font-size:11px}
.empty{text-align:center;padding:36px 16px;color:#666;background:#fff}
.xref-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.xref-grid .col{min-width:0}@media(max-width:768px){.xref-grid{grid-template-columns:1fr}}
.stacked{display:flex;gap:8px;flex-direction:column;max-height:300px;overflow-y:auto;padding-right:4px}
.stacked .scard{display:flex;gap:8px;align-items:center;padding:8px 10px;background:#f7f8f7;border:1px solid #ddd;border-radius:2px}
.stacked .scard:hover{border-color:#003366;background:#eef3f8}
.scard .tag{font-weight:700;color:#003366;font-size:12px;flex:1}
.scard .tagl{color:#555;font-size:11px}.scard .badge{font-size:10px;color:#666;background:#eee;padding:2px 6px;border-radius:999px}
#dbgToggle{cursor:pointer;font-size:11px;color:#003366;user-select:none;margin-top:10px;text-decoration:underline}
#debug{display:none;background:#fff8e1;border:1px solid #e0c060;color:#333;padding:6px;margin-top:4px;font-size:10px;font-family:Consolas,monospace;max-height:140px;overflow:auto;border-radius:2px;white-space:pre-wrap}
.chips{display:flex;flex-wrap:wrap;gap:5px;max-height:80px;overflow:auto;padding:2px}
.chip{display:inline-flex;align-items:center;gap:5px;background:#eee;border:1px solid #bbb;border-radius:12px;padding:3px 9px;font-size:11px;cursor:pointer;user-select:none;color:#222}
.chip:hover{background:#e4e9e7}.chip.sel{background:#003366;border-color:#003366;color:#fff}
.chip .dot{width:7px;height:7px;border-radius:50%;background:#999}.chip.sel .dot{background:#7ec8ff}
.gantt-wrap{overflow:auto;border:1px solid #aaa;background:#fff;position:relative;max-height:calc(100vh - 280px);user-select:none}
.gantt-row{display:flex;align-items:stretch;min-width:100%}
.gantt-lab{width:110px;flex:0 0 110px;box-sizing:border-box;padding:7px 8px;border-right:1px solid #ccc;font-size:11px;color:#003366;font-weight:700;display:flex;align-items:center;background:#fff;position:sticky;left:0;z-index:3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gantt-head{border-bottom:1px solid #aaa;background:#e4e9e7;position:sticky;top:0;z-index:4}
.gantt-head .gantt-lab{background:#e4e9e7;font-size:10px;color:#333;z-index:5;padding:6px 8px}
.gantt-track{flex:1 0 auto;position:relative;min-width:720px;box-sizing:border-box}
.gantt-tick{position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;pointer-events:none}
.gantt-tick span{position:absolute;top:6px;left:3px;font-size:8px;color:#666;white-space:nowrap}
.gantt-sel{position:absolute;top:0;bottom:0;background:rgba(0,51,102,.18);border:1px solid rgba(0,51,102,.45);pointer-events:none;z-index:6;box-sizing:border-box}
.gantt-now{position:absolute;top:0;bottom:0;width:2px;background:#c62828;z-index:10;cursor:pointer;box-shadow:0 0 4px rgba(198,40,40,.5)}
.gantt-now:hover{width:4px;background:#e53935}
.sess-click{cursor:pointer}
.detail-panel{background:#f7f8f7;border:1px solid #bbb;border-radius:2px;padding:8px;margin-top:6px;display:none}
.detail-panel .dp-title{font-weight:700;color:#003366;font-size:12px;margin-bottom:4px}
.detail-panel table{width:100%;font-size:11px}
.detail-panel td{padding:2px 6px;border-bottom:1px solid #eee}
.detail-panel .lbl{color:#666;font-weight:700;width:90px}
</style>
</head>
<body>
<div class="header">
  <div><h1>User Tracer</h1><div class="sub">Lastro AD · timeline ao vivo · cruzamento</div></div>
  <div class="stats">
    <div class="stat"><div class="n" id="sDevices">—</div><div class="l">Dispositivos</div></div>
    <div class="stat"><div class="n" id="sUsers">—</div><div class="l">Usuários</div></div>
    <div class="stat"><div class="n" id="sEvents">—</div><div class="l">Eventos</div></div>
  </div>
</div>

<div class="panel">
  <div class="panel-title">Timeline</div>
  <div class="toolbar">
    <label>De</label><input type="date" id="dStart" onchange="onDateChange()">
    <label>Até</label><input type="date" id="dEnd" onchange="onDateChange()">
    <button class="btn btn-sm" onclick="resetZoom()" title="Resetar zoom">↺</button>
    <span class="muted" style="margin-left:6px" id="tlFilter"></span>
  </div>
  <div id="gantt"><div class="empty">Selecione um usuário ou dispositivo abaixo.</div></div>
</div>

<div class="xref-grid">
  <div class="col">
    <div class="panel">
      <div class="panel-title">Usuário → Dispositivos</div>
      <div class="toolbar">
        <div class="sd-wrap" id="sdWrap-xrefUser">
          <input type="text" class="sd-sel" id="sdSel-xrefUser" value="— Selecione um usuário —" readonly onclick="sdToggle('xrefUser')" oninput="sdFilter('xrefUser',this.value)">
          <div class="sd-drop" id="sdDrop-xrefUser"><div class="sd-opts" id="sdOpts-xrefUser"></div></div>
          <select id="xrefUser" style="display:none" onchange="loadXrefUser()"><option value="">— Selecione um usuário —</option></select>
        </div>
        <button class="btn btn-primary" onclick="loadXrefUser()">Buscar</button><button class="btn btn-sm" onclick="resetUserFilter()" title="Limpar filtro" style="margin-left:2px;font-weight:700;color:#c62828">✕</button><button class="btn btn-sm" onclick="loadUserNames()" title="Atualizar lista" style="margin-left:2px">↻</button><span class="muted" id="hintUser"></span>
      </div>
      <div id="xrefUserResult"><div class="empty">Selecione um usuário.</div></div>
    </div>
  </div>
  <div class="col">
    <div class="panel">
      <div class="panel-title">Dispositivo → Usuários</div>
      <div class="toolbar">
        <div class="sd-wrap" id="sdWrap-xrefDev">
          <input type="text" class="sd-sel" id="sdSel-xrefDev" value="— Selecione um dispositivo —" readonly onclick="sdToggle('xrefDev')" oninput="sdFilter('xrefDev',this.value)">
          <div class="sd-drop" id="sdDrop-xrefDev"><div class="sd-opts" id="sdOpts-xrefDev"></div></div>
          <select id="xrefDev" style="display:none" onchange="loadXrefDev()"><option value="">— Selecione um dispositivo —</option></select>
        </div>
        <button class="btn btn-primary" onclick="loadXrefDev()">Buscar</button><button class="btn btn-sm" onclick="resetDevFilter()" title="Limpar filtro" style="margin-left:2px;font-weight:700;color:#c62828">✕</button><button class="btn btn-sm" onclick="loadDeviceNames()" title="Atualizar lista" style="margin-left:2px">↻</button><span class="muted" id="hintDev"></span>
      </div>
      <div id="xrefDevResult"><div class="empty">Selecione um dispositivo.</div></div>
    </div>
  </div>
</div>

<div id="dbgToggle" onclick="var e=document.getElementById('debug');e.style.display=e.style.display==='none'?'block':'none'">Debug</div>
<div id="debug">aguardando...</div>

<script>
var D=[],ms=(typeof top!=='undefined'&&top.meshserver)||(typeof parent!=='undefined'&&parent.meshserver)||window.meshserver;
var _allDevices=[],_allUsers=[],_xrefPending='',_reqUser='',_reqDev='',selectedDevs={};
var _eventsCache=[],_viewRange=null,_baseRange={rs:0,re:0},_pwrMap=null,_reqSeq=0,_activeUsers={};
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function segColor(st,op){return st==='lock'?'#e65100':st==='logout'?'#888':'#2e7d32';}
function dlog(){var a=Array.prototype.slice.call(arguments);D.push(new Date().toLocaleTimeString()+' '+a.join(' '));var e=document.getElementById('debug');if(e)e.innerHTML=D.slice(-80).join('\n');}
function eventMeta(t){return{color:t==='userLock'?'#e65100':t==='userLogout'?'#888':'#2e7d32',label:t==='userLock'?'Bloqueado':t==='userLogout'?'Offline':'Online',endLabel:t==='userLogin'?'<b>Agora</b>':t==='userUnlock'?'<b>Agora</b>':''};}
function fmtDate(d){var x=new Date(d);if(isNaN(x))return'—';var m=x.getMonth()+1,day=x.getDate();return (day<10?'0':'')+day+'/'+(m<10?'0':'')+m+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtShort(d){var x=new Date(d);if(isNaN(x))return'—';return (x.getDate()<10?'0':'')+x.getDate()+'/'+(x.getMonth()+1<10?'0':'')+(x.getMonth()+1)+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtDur(ms){if(ms<0)ms=0;var m=Math.floor(ms/60000),h=Math.floor(m/60),d=Math.floor(h/24);m%=60;h%=24;if(d>0)return d+'d '+h+'h';if(h>0)return h+'h '+m+'m';return m+'m';}
function ymd(d){var x=new Date(d),m=x.getMonth()+1,day=x.getDate();return x.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(day<10?'0':'')+day;}
function colorFor(k){var h=0,s=String(k||'');for(var i=0;i<s.length;i++)h=((h<<5)-h)+s.charCodeAt(i)|0;return ['#003366','#1565c0','#2e7d32','#6a1b9a','#00838f','#ef6c00','#c62828','#455a64','#5d4037','#283593'][Math.abs(h)%10];}
function splitUser(u){var p=String(u||'').split('\\');return p.length>1?{d:p[0],u:p[1]}:{d:'',u:u||''};}
/* --- Searchable dropdown (input that transforms into search) --- */
var _sdOpen=null;
document.addEventListener('click',function(e){if(_sdOpen){var w=document.getElementById('sdWrap-'+_sdOpen);if(w&&!w.contains(e.target))sdClose(_sdOpen);}});
function sdToggle(id){if(_sdOpen&&_sdOpen!==id)sdClose(_sdOpen);var d=document.getElementById('sdDrop-'+id);var inp=document.getElementById('sdSel-'+id);if(!d||!inp)return;if(d.style.display==='block'){sdClose(id);}else{d.style.display='block';_sdOpen=id;inp.readOnly=false;inp.value='';inp.focus();sdFilter(id,'');}}
function sdClose(id){var d=document.getElementById('sdDrop-'+id);var inp=document.getElementById('sdSel-'+id);if(d)d.style.display='none';if(_sdOpen===id)_sdOpen=null;if(inp){inp.readOnly=true;sdDisplay(id);}}
function sdFilter(id,q){var list=document.getElementById('sdOpts-'+id);if(!list)return;q=String(q||'').toLowerCase();Array.from(list.children).forEach(function(el){el.style.display=(!q||el.textContent.toLowerCase().indexOf(q)>=0)?'':'none';});}
function sdSelect(id,val){var sel=document.getElementById(id);if(!sel)return;for(var i=0;i<sel.options.length;i++){if(sel.options[i].value===val){sel.selectedIndex=i;break;}}sdClose(id);if(typeof sel.onchange==='function')sel.onchange();}
function sdSync(id){var sel=document.getElementById(id);var list=document.getElementById('sdOpts-'+id);if(!sel||!list)return;list.innerHTML='';Array.from(sel.options).forEach(function(opt,i){if(!opt.value&&i===0)return;var d=document.createElement('div');d.className='sd-opt';d.textContent=opt.textContent;d.setAttribute('data-val',opt.value);d.onclick=function(){sdSelect(id,opt.value);};list.appendChild(d);});sdDisplay(id);}
function sdDisplay(id){var sel=document.getElementById(id);var inp=document.getElementById('sdSel-'+id);if(sel&&inp){inp.value=sel.options[sel.selectedIndex]?sel.options[sel.selectedIndex].textContent:'';inp.readOnly=true;}}
/* --- end searchable dropdown --- */


function loadDeviceNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getDeviceNames'});}
function renderDeviceNames(list){
  _allDevices=(list||[]).slice().sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
  document.getElementById('sDevices').textContent=_allDevices.length;
  _allDevices.forEach(function(d){if(selectedDevs[d.nodeid]===undefined)selectedDevs[d.nodeid]=true;});
  _populateXrefDevs(_allDevices);
}
function loadTimeline(){
  var u=document.getElementById('xrefUser').value,d=document.getElementById('xrefDev').value;
  if(u)loadXrefUser();else if(d)loadXrefDev();
}
function buildSessions(events,rs,re){
  var by={};
  events.slice().sort(function(a,b){return new Date(a.detectedAt)-new Date(b.detectedAt);}).forEach(function(e){
    var k=e.nodeid+'|'+(e.displayUser||e.username||'?');
    if(!by[k])by[k]={nodeid:e.nodeid,nodeName:e.nodeName,user:e.username,display:e.displayUser||e.username,events:[]};by[k].events.push(e);
  });
  var out=[];Object.keys(by).forEach(function(k){
    var g=by[k],start=null,state='offline';
    g.events.forEach(function(e){
      var t=new Date(e.detectedAt).getTime();
      if(e.eventType==='userLogin'){
        if(start!=null)out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,start),end:Math.min(re,t),state:state});
        start=t;state='login';
      }else if(e.eventType==='userLock'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,start),end:Math.min(re,t),state:state});}
        start=t;state='lock';
      }else if(e.eventType==='userUnlock'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,start),end:Math.min(re,t),state:state});}
        start=t;state='unlock';
      }else if(e.eventType==='userLogout'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,start),end:Math.min(re,t),state:state});start=null;}
        else out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,t-30*60000),end:Math.min(re,t),state:'logout'});
      }
    });if(start!=null){var segEnd=Math.min(re,Date.now());if(segEnd>rs)out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,start),end:segEnd,state:state,open:true});}
  });return out;
}
function pickerRange(){
  var rs=new Date(document.getElementById('dStart').value+'T00:00:00').getTime();
  var re=new Date(document.getElementById('dEnd').value+'T23:59:59.999').getTime();
  if(isNaN(rs)||isNaN(re)||re<=rs){rs=Date.now()-8*3600000;re=Date.now();}
  return {rs:rs,re:re};
}
function activeRange(){
  if(_viewRange&&_viewRange.re>_viewRange.rs)return _viewRange;
  return _baseRange.rs?_baseRange:pickerRange();
}
function setViewHint(){
  var el=document.getElementById('tlFilter');if(!el)return;
  var base=el.getAttribute('data-base')||'';
  if(!_viewRange){el.textContent=base;return;}
  el.textContent=(base?base+' · ':'')+fmtDate(_viewRange.rs)+' → '+fmtDate(_viewRange.re)+' ('+fmtDur(_viewRange.re-_viewRange.rs)+')';
}
function onDateChange(){
  _viewRange=null;
  _baseRange=pickerRange();
  loadTimeline();
}
function resetZoom(){
  if(!_eventsCache.length){_viewRange=null;loadTimeline();return;}
  _viewRange=null;
  _baseRange=pickerRange();
  setViewHint();
  _renderGantt(_eventsCache,_baseRange.rs,_baseRange.re,_pwrMap);
}
function zoomTo(rs,re){
  rs=Math.floor(rs);re=Math.ceil(re);
  if(!(re>rs))return;
  if(re-rs<60000){var mid=(rs+re)/2;rs=mid-30000;re=mid+30000;}
  _viewRange={rs:rs,re:re};
  setViewHint();
  if(!_eventsCache.length){loadTimeline();return;}
  _renderGantt(_eventsCache,rs,re,_pwrMap);
}
function _renderGantt(events,rs,re,pwrMap){
  document.getElementById('sEvents').textContent=events.length;
  var total=re-rs;if(total<=0)total=1;
  var sessions=buildSessions(events,rs,re),dayMs=86400000,span=total/dayMs;
  // Override open session state: if user is active on device (from MeshCentral db.Get), force 'login'
  sessions.forEach(function(s){if(s.open){var da=_activeUsers[s.nodeid]||[];var sUser=splitUser(s.display||s.user||'').u||s.display||s.user;for(var si=0;si<da.length;si++){var daShort=splitUser(da[si]).u||da[si];if(daShort===sUser||da[si]===s.display||daShort===(s.user||'')||da[si]===(s.user||'')){s.state='login';break;}}}});
  var step=span<=0.02?60000:(span<=0.08?300000:(span<=0.25?900000:(span<=0.5?1800000:(span<=1?3600000:(span<=7?10800000:(span<=14?21600000:43200000))))));
  var ticks=[],t0=Math.ceil(rs/step)*step;
  for(var t=t0;t<=re;t+=step){
    var d=new Date(t),lab;
    if(step<3600000)lab=(d.getHours()<10?'0':'')+d.getHours()+':'+(d.getMinutes()<10?'0':'')+d.getMinutes();
    else if(step<dayMs)lab=(d.getHours()<10?'0':'')+d.getHours()+':00';
    else lab=(d.getDate()<10?'0':'')+d.getDate()+'/'+(d.getMonth()+1<10?'0':'')+(d.getMonth()+1);
    ticks.push({pct:((t-rs)/total)*100,label:lab});
  }
  var mw=Math.max(720,Math.min(3600,Math.floor(span*140)));
  var trackBase=' class="gantt-track" data-rs="'+rs+'" data-re="'+re+'"';
  var h='<div class="gantt-wrap"><div class="gantt-row gantt-head"><div class="gantt-lab">DISPOSITIVO</div><div'+trackBase+' style="min-width:'+mw+'px;height:28px">';
  ticks.forEach(function(tk){h+='<div class="gantt-tick" style="left:'+tk.pct+'%"><span>'+esc(tk.label)+'</span></div>';});
  h+='</div></div>';
  var byDev={};sessions.forEach(function(s){var n=s.nodeName||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};byDev[n].sessions.push(s);});
  events.forEach(function(e){var n=e.nodeName||e.nodeid||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};});
  var names=Object.keys(byDev).sort();
  names.forEach(function(name){
    var dev=byDev[name];
    var byU={};dev.sessions.forEach(function(s){var k=s.display||s.user||'?';if(!byU[k])byU[k]=[];byU[k].push(s);});
    var uNames=Object.keys(byU).sort();
    var rowH=Math.max(38,10+uNames.length*22);
    h+='<div class="gantt-row" style="min-height:'+rowH+'px;border-bottom:1px solid #e0e0e0"><div class="gantt-lab" title="'+esc(name)+'">'+esc(name)+'</div><div'+trackBase+' style="min-width:'+mw+'px;min-height:'+rowH+'px">';
    ticks.forEach(function(tk){h+='<div class="gantt-tick" style="left:'+tk.pct+'%"></div>';});
    uNames.forEach(function(un,ui){
      var segs=byU[un];if(!segs.length)return;
      segs.sort(function(a,b){return a.start-b.start;});
      var fst=segs[0],lst=segs[segs.length-1];
      var barLeft=Math.max(0,((fst.start-rs)/total)*100),barRight=Math.min(100,((lst.end-rs)/total)*100);if(barRight<=barLeft)barRight=barLeft+0.15;
      var barW=barRight-barLeft,isOpen=segs.some(function(s){return s.open;}),topPos=8+ui*22;
      h+='<div style="position:absolute;top:'+topPos+'px;height:18px;left:'+barLeft+'%;width:'+barW+'%;border-radius:2px;overflow:hidden;display:flex;border:'+(isOpen?'2px dashed':'1px solid')+' rgba(0,0,0,.2)">';
      segs.forEach(function(s){
        var sLeft=Math.max(0,((s.start-rs)/total)*100),sRight=Math.min(100,((s.end-rs)/total)*100);if(sRight<=sLeft)sRight=sLeft+0.15;
        var pct=((sRight-sLeft)/barW)*100;if(pct<0.2)pct=0.2;
        var em2=eventMeta(s.state==='lock'?'userLock':s.state==='unlock'?'userUnlock':s.state==='login'?'userLogin':'userLogout');
        var tt='Usuário: '+esc(s.user||s.display)+'\nDe: '+fmtDate(s.start)+'\nAté: '+fmtDate(s.end)+'\nEstado: '+em2.label+'\nDuração: '+fmtDur(s.end-s.start);
        h+='<div style="height:100%;width:'+pct+'%;background:'+segColor(s.state,s.open)+';border-right:1px solid rgba(0,0,0,.15);min-width:2px;cursor:zoom-in" title="'+esc(tt)+'" ondblclick="event.stopPropagation();zoomTo('+s.start+','+s.end+')"></div>';
      });
      h+='<span style="position:absolute;top:1px;left:3px;font-size:8px;font-weight:700;color:#fff;text-shadow:0 0 2px rgba(0,0,0,.6);pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100% - 6px)" title="'+esc(segs[0].user||'')+'">'+esc(segs[0].user||'')+'</span>';
      h+='</div>';
    });
    h+='</div></div>';
  });
  h+='</div>';
  document.getElementById('gantt').innerHTML=h;
  setupGanttDrag();
}
function renderTimeline(events,pwrMap){
  events=events||[];
  _eventsCache=events;
  _pwrMap=pwrMap||null;
  _baseRange=pickerRange();
  if(!events.length){document.getElementById('gantt').innerHTML='<div class="empty">Nenhum evento no período.</div>';return;}
  var r=activeRange();
  var rs=r.rs,re=r.re;
  if(isNaN(rs)||isNaN(re)||re<=rs){
    rs=Infinity;re=-Infinity;
    events.forEach(function(e){var t=new Date(e.detectedAt).getTime();if(t<rs)rs=t;if(t>re)re=t;});
    if(re<=rs)re=rs+86400000;
    _baseRange={rs:rs,re:re};
  }
  setViewHint();
  _renderGantt(events,rs,re,pwrMap);
}
function setupGanttDrag(){
  var wrap=document.querySelector('.gantt-wrap');if(!wrap)return;
  var drag=null;
  function trackOf(el){
    while(el&&el!==wrap){if(el.classList&&el.classList.contains('gantt-track'))return el;el=el.parentNode;}
    return wrap.querySelector('.gantt-track');
  }
  function timeAt(track,clientX){
    if(!track)return 0;
    var rs=+track.getAttribute('data-rs'),re=+track.getAttribute('data-re');
    var rect=track.getBoundingClientRect();
    var w=rect.width;if(w<=0)return rs;
    var x=clientX-rect.left;
    if(x<0)x=0;if(x>w)x=w;
    return rs+(x/w)*(re-rs);
  }
  function pxAt(track,clientX){
    if(!track)return 0;
    var rect=track.getBoundingClientRect();
    var w=rect.width;if(w<=0)return 0;
    var x=clientX-rect.left;
    if(x<0)x=0;if(x>w)x=w;
    return x;
  }
  function onMove(e){
    if(!drag)return;
    drag.t1=timeAt(drag.track,e.clientX);
    drag.x1=pxAt(drag.track,e.clientX);
    var a=Math.min(drag.x0,drag.x1),b=Math.max(drag.x0,drag.x1);
    if(drag.ov){drag.ov.style.left=a+'px';drag.ov.style.width=Math.max(1,b-a)+'px';}
  }
  function onUp(e){
    document.removeEventListener('mousemove',onMove,true);
    document.removeEventListener('mouseup',onUp,true);
    if(!drag)return;
    if(e){drag.t1=timeAt(drag.track,e.clientX);}
    var t0=Math.min(drag.t0,drag.t1),t1=Math.max(drag.t0,drag.t1);
    if(drag.ov&&drag.ov.parentNode)drag.ov.parentNode.removeChild(drag.ov);
    var d=drag;drag=null;
    if(t1-t0<30000)return; // min 30s selection
    dlog('ZOOM',new Date(t0).toLocaleTimeString(),'→',new Date(t1).toLocaleTimeString());
    zoomTo(t0,t1);
  }
  wrap.addEventListener('mousedown',function(e){
    if(e.button!==0)return;
    var t=e.target,onLab=false;
    while(t&&t!==wrap){if(t.classList&&t.classList.contains('gantt-lab')){onLab=true;break;}t=t.parentNode;}
    if(onLab)return;
    var track=trackOf(e.target);if(!track)return;
    e.preventDefault();
    var ov=document.createElement('div');ov.className='gantt-sel';
    var x=pxAt(track,e.clientX);ov.style.left=x+'px';ov.style.width='1px';
    track.appendChild(ov);
    drag={track:track,t0:timeAt(track,e.clientX),t1:timeAt(track,e.clientX),x0:x,x1:x,ov:ov};
    document.addEventListener('mousemove',onMove,true);
    document.addEventListener('mouseup',onUp,true);
  });
}
function loadUserNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getUserNames'});}
function renderUserNames(list){
  _allUsers=(list||[]).slice().sort(function(a,b){return String(a.displayUser||a.username).localeCompare(String(b.displayUser||b.username));});
  document.getElementById('sUsers').textContent=_allUsers.length;
  var sel=document.getElementById('xrefUser');sel.innerHTML='<option value="">— Selecione um usuário —</option>';
  _allUsers.forEach(function(u){var opt=document.createElement('option');opt.value=(u.username||u.displayUser);opt.textContent=(u.displayUser||u.username);sel.appendChild(opt);});
  // Re-aplica filtro se ativo
  sdSync('xrefUser');
}
function _populateXrefDevs(list){
  var devSel=document.getElementById('xrefDev');devSel.innerHTML='<option value="">— Selecione um dispositivo —</option>';
  list.sort(function(a,b){return String(a.name).localeCompare(String(b.name));}).forEach(function(d){var opt=document.createElement('option');opt.value=d.nodeid;opt.textContent=d.name;devSel.appendChild(opt);});
  // Re-aplica filtro se ativo
  sdSync('xrefDev');
}
function gotoDev(nid){document.getElementById('xrefDev').value=nid;sdDisplay('xrefDev');loadXrefDev();}
function gotoUser(displayUser){
  var sel=document.getElementById('xrefUser');
  for(var i=0;i<sel.options.length;i++){if(sel.options[i].textContent===displayUser||sel.options[i].value===displayUser){sel.selectedIndex=i;sdDisplay('xrefUser');loadXrefUser();return;}}
}
function resetUserFilter(){
  _viewRange=null;_eventsCache=[];
  document.getElementById('xrefUser').value='';document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';
  sdDisplay('xrefUser');
  document.getElementById('hintUser').textContent='';_populateXrefDevs(_allDevices);
  document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';document.getElementById('hintDev').textContent='';
  document.getElementById('tlFilter').textContent='';document.getElementById('tlFilter').removeAttribute('data-base');document.getElementById('gantt').innerHTML='<div class="empty">Selecione um usuário ou dispositivo.</div>';
}
function resetDevFilter(){
  _viewRange=null;_eventsCache=[];
  document.getElementById('xrefDev').value='';document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';
