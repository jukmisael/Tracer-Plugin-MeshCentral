    var isOn2=false;for(var ai2=0;ai2<da.length;ai2++){var aShort2=splitUser(da[ai2]).u||da[ai2];if(aShort2===un.u||da[ai2]===g.user||aShort2===g.user||da[ai2]===un.u){isOn2=true;break;}}
    var em=eventMeta(last.eventType);
    h+='<div class="scard" onclick="gotoUser(\''+esc(g.user)+'\')"><div style="flex:1"><div class="tag">'+esc(un.u||g.user)+'</div><div class="tagl">'+(g.domain?esc(g.domain)+' · ':'')+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(em.endLabel||fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+em.color+'">'+em.label+'</span></div>';});
