(function(){
    if (_unmounted) return;
    // #2 — handler único no socket RAW, sem mexer em pluginHandler global
    if (ms && ms.socket) {
        _wsHandler = makeWSHandler();
        try { ms.socket.addEventListener('message', _wsHandler); dlog('WS','installed'); }
        catch (ex) { dlog('WSE','addEventListener', ex.message); ms.socket.onmessage = _wsHandler; }
    } else { dlog('WS','no socket'); }

    // #12 - cleanup ao sair da página/iframe
    window.addEventListener('beforeunload', function () {
        _unmounted = true;
        if (ms && ms.socket && _wsHandler) {
            try { ms.socket.removeEventListener('message', _wsHandler); } catch (_) {}
        }
        _wsHandler = null;
        Object.keys(_sendDebounced).forEach(function (k) { _sendDebounced[k] = false; });
    });
    window.addEventListener('unload', function () {
        _unmounted = true;
        if (ms && ms.socket && _wsHandler) {
            try { ms.socket.removeEventListener('message', _wsHandler); } catch (_) {}
        }
    });
})();
