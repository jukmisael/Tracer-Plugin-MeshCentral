  sdSync('xrefUser');
  document.getElementById('tlFilter').textContent='';document.getElementById('tlFilter').removeAttribute('data-base');document.getElementById('gantt').innerHTML='<div class="empty">Selecione um usuário ou dispositivo.</div>';
}
function loadXrefUser(){
  var u=document.getElementById('xrefUser').value;if(!u){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';return;}
  _reqUser=u;_viewRange=null;
  document.getElementById('xrefUserResult').innerHTML='<div class="loading">Buscando...</div>';document.getElementById('hintUser').textContent='';
  _xrefPending='user';document.getElementById('gantt').innerHTML='<div class="loading">Carregando...</div>';
  var baseTxt='Usuário: '+u;document.getElementById('tlFilter').setAttribute('data-base',baseTxt);document.getElementById('tlFilter').textContent=baseTxt;
  var pr=pickerRange();
  if(ms){var _s=++_reqSeq;ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',username:u,startDate:new Date(pr.rs).toISOString(),endDate:new Date(pr.re).toISOString(),limit:8000,_reqSeq:_s});}
}
function loadXrefDev(){
  var n=document.getElementById('xrefDev').value;if(!n){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';return;}
  _reqDev=n;_viewRange=null;
  document.getElementById('xrefDevResult').innerHTML='<div class="loading">Buscando...</div>';document.getElementById('hintDev').textContent='';
  _xrefPending='dev';document.getElementById('gantt').innerHTML='<div class="loading">Carregando...</div>';
  var baseTxt='Dispositivo: '+document.getElementById('xrefDev').options[document.getElementById('xrefDev').selectedIndex].text;
  document.getElementById('tlFilter').setAttribute('data-base',baseTxt);document.getElementById('tlFilter').textContent=baseTxt;
  var pr=pickerRange();
  if(ms){var _s=++_reqSeq;ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',nodeid:n,startDate:new Date(pr.rs).toISOString(),endDate:new Date(pr.re).toISOString(),limit:8000,_reqSeq:_s});}
}
function renderXrefUser(e){e=e||[];document.getElementById('sEvents').textContent=e.length;if(!e.length){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Nenhum evento encontrado.</div>';return;}
  if(document.getElementById('xrefUser').value!==_reqUser){dlog('STALE','user response ignored');return;}
  var by={};e.forEach(function(v){var n=v.nodeName||v.nodeid||'?';if(!by[n])by[n]={name:n,nodeid:v.nodeid,events:[]};by[n].events.push(v);});
  var names=Object.keys(by).sort();document.getElementById('hintUser').textContent=e.length+' eventos em '+names.length+' dispositivos';
  var selUser=document.getElementById('xrefUser').value||'';
  var selShort=splitUser(selUser).u||selUser;
  var h='<div class="stacked">';names.forEach(function(n){var evs=by[n].events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);}),last=evs[0],first=evs[evs.length-1];
  var da=_activeUsers[by[n].nodeid]||[];var isOn=false;
  for(var ai=0;ai<da.length;ai++){var aShort=splitUser(da[ai]).u||da[ai];if(aShort===selShort||da[ai]===selUser||aShort===selUser||da[ai]===selShort){isOn=true;break;}}
  var em=isOn?{color:'#2e7d32',label:'Online'}:eventMeta(last.eventType);
  h+='<div class="scard" style="cursor:pointer" onclick="gotoDev(\''+esc(by[n].nodeid)+'\')"><div style="flex:1"><div class="tag">'+esc(n)+'</div><div class="tagl">'+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(em.endLabel||fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+em.color+'">'+em.label+'</span></div>';});
  h+='</div>';document.getElementById('xrefUserResult').innerHTML=h;
  // Se usuario selecionado, filtra dispositivos relacionados
  if(document.getElementById('xrefUser').value){
    var devSel=document.getElementById('xrefDev');var curVal=devSel.value;devSel.innerHTML='<option value="">— Relacionados —</option>';
    var opts=[];names.forEach(function(n){var d=by[n];opts.push(d);});opts.sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
    opts.forEach(function(d){var opt=document.createElement('option');opt.value=d.nodeid;opt.textContent=d.name;if(d.nodeid===curVal)opt.selected=true;devSel.appendChild(opt);});
    // Re-aplica filtro se ativo
    sdSync('xrefDev');
  }
}
function renderXrefDev(e){e=e||[];document.getElementById('sEvents').textContent=e.length;if(!e.length){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Nenhum evento encontrado.</div>';return;}
  if(document.getElementById('xrefDev').value!==_reqDev){dlog('STALE','dev response ignored');return;}
  var by={};e.forEach(function(v){var u=v.displayUser||v.username||'?';if(!by[u])by[u]={user:u,domain:v.domain,events:[]};by[u].events.push(v);});
  var names=Object.keys(by).sort();document.getElementById('hintDev').textContent=e.length+' eventos de '+names.length+' usuários';
  var devId=document.getElementById('xrefDev').value||'';var da=_activeUsers[devId]||[];
  var h='<div class="stacked">';names.forEach(function(u){var g=by[u],evs=g.events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);}),last=evs[0],first=evs[evs.length-1],un=splitUser(g.user);
  var isOn2=false;for(var ai2=0;ai2<da.length;ai2++){var aShort2=splitUser(da[ai2]).u||da[ai2];if(aShort2===un.u||da[ai2]===g.user||aShort2===g.user||da[ai2]===un.u){isOn2=true;break;}}
  var em=isOn2?{color:'#2e7d32',label:'Online'}:eventMeta(last.eventType);var _gud=esc((un.user||g.user).replace(/\\/g,'\\\\'));h+='<div class="scard" style="cursor:pointer" onclick="gotoUser(\''+_gud+'\')"><div style="flex:1"><div class="tag">'+esc(un.user||g.user)+'</div><div class="tagl">'+(g.domain?esc(g.domain)+' · ':'')+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(em.endLabel||fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+em.color+'">'+em.label+'</span></div>';});
  h+='</div>';document.getElementById('xrefDevResult').innerHTML=h;
  // Se dispositivo selecionado, filtra usuarios relacionados (usa g.user = displayUser, sem reconstruir dominio)
  if(document.getElementById('xrefDev').value){
    var usrSel=document.getElementById('xrefUser');var curVal=usrSel.value;usrSel.innerHTML='<option value="">— Relacionados —</option>';
    names.forEach(function(u){var g=by[u];var un=splitUser(g.user);var opt=document.createElement('option');opt.value=(un.user||g.user);opt.textContent=g.user;if((un.user||g.user)===curVal||g.user===curVal)opt.selected=true;usrSel.appendChild(opt);});
    // Re-aplica filtro se ativo
    sdSync('xrefUser');
  }
}
(function(){
  // pluginHandler registration (MeshCentral chama na inicialização, ignoramos se for meshserver obj)
  try{
    var ph=(top&&top.pluginHandler&&top.pluginHandler.usertracer)||(parent&&parent.pluginHandler&&parent.pluginHandler.usertracer);
    if(ph){
      ph.timeline=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','timeline n='+m.data.length);if(m._reqSeq&&m._reqSeq!==_reqSeq){dlog('PH_STALE','timeline',m._reqSeq,'!=',_reqSeq);return;}try{if(_xrefPending==='user'){renderXrefUser(m.data);_xrefPending='';}else if(_xrefPending==='dev'){renderXrefDev(m.data);_xrefPending='';}else _xrefPending='';}catch(ex2){dlog('PH_XREF_ERR',ex2.message);_xrefPending='';}renderTimeline(m.data,m._pwrMap);}else dlog('PHSKIP','timeline',typeof m);};
      ph.deviceNames=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','deviceNames n='+m.data.length);renderDeviceNames(m.data);}else dlog('PHSKIP','deviceNames',typeof m);};
      ph.userNames=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','userNames n='+m.data.length);renderUserNames(m.data);}else dlog('PHSKIP','userNames',typeof m);};
      dlog('PH','registered');
    }
  }catch(e){dlog('PHE','err',e.message);}
  // WebSocket handler — single addEventListener, no onmessage override (prevents triple-fire)
  if(ms&&ms.socket){
    var handler=function(e){
      try{var d=JSON.parse(e.data);dlog('WS_RAW',d.action,d.plugin,d.method,typeof d.data);if(d.action==='plugin'&&d.plugin==='usertracer'){
        dlog('WS',d.method,Array.isArray(d.data)?('n='+d.data.length):typeof d.data);
        if(d.method==='deviceNames'||d.method==='userNames'){/* no stale check for bootstrap calls */}
        else if(d._reqSeq&&d._reqSeq!==_reqSeq){dlog('WS_STALE',d.method,d._reqSeq,'!=',_reqSeq);return;}
        if(d.method==='deviceNames')renderDeviceNames(d.data||[]);
        else if(d.method==='userNames')renderUserNames(d.data||[]);
        else if(d.method==='timeline'){
          try{
            if(d._activeUsers)_activeUsers=d._activeUsers;
            if(_xrefPending==='user'){renderXrefUser(d.data||[]);_xrefPending='';}
            else if(_xrefPending==='dev'){renderXrefDev(d.data||[]);_xrefPending='';}else _xrefPending='';
          }catch(ex2){dlog('WS_XREF_ERR',ex2.message);_xrefPending='';}
          renderTimeline(d.data||[],d._pwrMap);
        }
      }}catch(ex){}
    };
    try{ms.socket.addEventListener('message',handler);dlog('WS','installed');}
    catch(ex){dlog('WSE','addEventListener',ex.message);ms.socket.onmessage=handler;}
  } else {dlog('WS','no socket');}
})();
var _d=new Date();document.getElementById('dStart').value=ymd(new Date(_d.getTime()-28800000));document.getElementById('dEnd').value=ymd(_d);
loadDeviceNames();loadUserNames();
</script>
