<html>
<head>
<meta charset="utf-8">
<title>User Tracer</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Trebuchet MS",Arial,Helvetica,sans-serif;background:#d3d9d6;color:#000;padding:12px;font-size:13px;line-height:1.35}
.header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.header h1{font-size:18px;font-weight:700;color:#003366}.header .sub{color:#444;font-size:12px;margin-top:2px}
.stats{display:flex;gap:6px;flex-wrap:wrap}
.stat{background:#fff;border:1px solid #aaa;border-radius:3px;padding:8px 12px;min-width:88px}
.stat .n{font-size:18px;font-weight:700;color:#003366}.stat .l{font-size:10px;color:#666;text-transform:uppercase;margin-top:1px}
.panel{background:#fff;border:1px solid #aaa;border-radius:3px;padding:10px;margin-bottom:10px}
.panel-title{background:#c0c0c0;color:#000;font-size:12px;font-weight:700;padding:5px 8px;margin:-10px -10px 10px -10px;border-bottom:1px solid #aaa}
.toolbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.toolbar label{font-size:11px;color:#444;font-weight:700}
.toolbar select,.toolbar input{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px}
.btn{font-family:inherit;font-size:12px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:5px 12px;border-radius:2px;cursor:pointer}
.btn:hover{background:#e4e4e4}.btn-primary{background:#003366;color:#fff;border-color:#002244}
.btn-primary:hover{background:#004080}
.btn-sm{font-family:inherit;font-size:11px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:3px 8px;border-radius:2px;cursor:pointer}
.btn-sm:hover{background:#e4e4e4}
.tbsep{display:inline-block;width:1px;height:20px;background:#bbb;margin:0 6px}
.devlabel{font-size:11px;color:#444;font-weight:700;margin-right:2px}
.devsearch{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px;width:140px}
.btn-live{background:#c62828;color:#fff;border-color:#a02121;font-weight:700}
.btn-live.active{background:#2e7d32;border-color:#1b5e20}
.btn-chip{background:#ddd;border:1px solid #aaa;color:#333;padding:4px 10px;font-size:11px}
.btn-chip.active{background:#003366;color:#fff;border-color:#003366;font-weight:700}
.loading{text-align:center;padding:28px;color:#666}.muted{color:#666;font-size:11px}
.empty{text-align:center;padding:36px 16px;color:#666;background:#fff}
.xref-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.xref-grid .col{min-width:0}@media(max-width:768px){.xref-grid{grid-template-columns:1fr}}
.stacked{display:flex;gap:8px;flex-direction:column;max-height:300px;overflow-y:auto;padding-right:4px}
.stacked .scard{display:flex;gap:8px;align-items:center;padding:8px 10px;background:#f7f8f7;border:1px solid #ddd;border-radius:2px}
.stacked .scard:hover{border-color:#003366;background:#eef3f8}
.scard .tag{font-weight:700;color:#003366;font-size:12px;flex:1}
.scard .tagl{color:#555;font-size:11px}.scard .badge{font-size:10px;color:#666;background:#eee;padding:2px 6px;border-radius:999px}
#dbgToggle{cursor:pointer;font-size:11px;color:#003366;user-select:none;margin-top:10px;text-decoration:underline}
#debug{display:none;background:#fff8e1;border:1px solid #e0c060;color:#333;padding:6px;margin-top:4px;font-size:10px;font-family:Consolas,monospace;max-height:140px;overflow:auto;border-radius:2px;white-space:pre-wrap}
.chips{display:flex;flex-wrap:wrap;gap:5px;max-height:80px;overflow:auto;padding:2px}
.chip{display:inline-flex;align-items:center;gap:5px;background:#eee;border:1px solid #bbb;border-radius:12px;padding:3px 9px;font-size:11px;cursor:pointer;user-select:none;color:#222}
.chip:hover{background:#e4e9e7}.chip.sel{background:#003366;border-color:#003366;color:#fff}
.chip .dot{width:7px;height:7px;border-radius:50%;background:#999}.chip.sel .dot{background:#7ec8ff}
.gantt-wrap{overflow:auto;border:1px solid #aaa;background:#fff;position:relative;max-height:calc(100vh - 280px)}
.gantt-now{position:absolute;top:0;bottom:0;width:2px;background:#c62828;z-index:10;cursor:pointer;box-shadow:0 0 4px rgba(198,40,40,.5)}
.gantt-now:hover{width:4px;background:#e53935}
.sess-click{cursor:pointer}
.detail-panel{background:#f7f8f7;border:1px solid #bbb;border-radius:2px;padding:8px;margin-top:6px;display:none}
.detail-panel .dp-title{font-weight:700;color:#003366;font-size:12px;margin-bottom:4px}
.detail-panel table{width:100%;font-size:11px}
.detail-panel td{padding:2px 6px;border-bottom:1px solid #eee}
.detail-panel .lbl{color:#666;font-weight:700;width:90px}
</style>
</head>
<body>
<div class="header">
  <div><h1>User Tracer</h1><div class="sub">Lastro AD · timeline ao vivo · cruzamento</div></div>
  <div class="stats">
    <div class="stat"><div class="n" id="sDevices">—</div><div class="l">Dispositivos</div></div>
    <div class="stat"><div class="n" id="sUsers">—</div><div class="l">Usuários</div></div>
    <div class="stat"><div class="n" id="sEvents">—</div><div class="l">Eventos</div></div>
  </div>
</div>

<div class="panel">
  <div class="panel-title">Timeline</div>
  <div class="toolbar">
    <label>De</label><input type="date" id="dStart" onchange="_selectedRange=null;_fullRange=null;loadTimeline()">
    <label>Até</label><input type="date" id="dEnd" onchange="_selectedRange=null;_fullRange=null;loadTimeline()">
    <button class="btn btn-sm" onclick="_selectedRange=null;_fullRange=null;loadTimeline()" title="Resetar zoom">↺</button>
    <span class="muted" style="margin-left:6px" id="tlFilter"></span>
  </div>
  <div id="gantt"><div class="empty">Selecione um usuário ou dispositivo abaixo.</div></div>
</div>

<div class="xref-grid">
  <div class="col">
    <div class="panel">
      <div class="panel-title">Usuário → Dispositivos</div>
      <div class="toolbar">
        <select id="xrefUser" style="flex:1" onchange="loadXrefUser()"><option value="">— Selecione um usuário —</option></select>
        <button class="btn btn-primary" onclick="loadXrefUser()">Buscar</button><button class="btn btn-sm" onclick="resetUserFilter()" title="Limpar filtro" style="margin-left:2px;font-weight:700;color:#c62828">✕</button><button class="btn btn-sm" onclick="loadUserNames()" title="Atualizar lista" style="margin-left:2px">↻</button><span class="muted" id="hintUser"></span>
      </div>
      <div id="xrefUserResult"><div class="empty">Selecione um usuário.</div></div>
    </div>
  </div>
  <div class="col">
    <div class="panel">
      <div class="panel-title">Dispositivo → Usuários</div>
      <div class="toolbar">
        <select id="xrefDev" style="flex:1" onchange="loadXrefDev()"><option value="">— Selecione um dispositivo —</option></select>
        <button class="btn btn-primary" onclick="loadXrefDev()">Buscar</button><button class="btn btn-sm" onclick="resetDevFilter()" title="Limpar filtro" style="margin-left:2px;font-weight:700;color:#c62828">✕</button><button class="btn btn-sm" onclick="loadDeviceNames()" title="Atualizar lista" style="margin-left:2px">↻</button><span class="muted" id="hintDev"></span>
      </div>
      <div id="xrefDevResult"><div class="empty">Selecione um dispositivo.</div></div>
    </div>
  </div>
</div>

<div id="dbgToggle" onclick="var e=document.getElementById('debug');e.style.display=e.style.display==='none'?'block':'none'">Debug</div>
<div id="debug">aguardando...</div>

<script>
var D=[],ms=(typeof top!=='undefined'&&top.meshserver)||(typeof parent!=='undefined'&&parent.meshserver)||window.meshserver;
var _allDevices=[],_allUsers=[],_xrefPending='',_selectedRange=null,_fullRange=null,selectedDevs={};
var _savedEvents=[],_savedRange={rs:0,re:0};
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function segColor(st,op){return st==='lock'?'#e65100':st==='logout'?'#888':'#2e7d32';}
function dlog(){var a=Array.prototype.slice.call(arguments);D.push(new Date().toLocaleTimeString()+' '+a.join(' '));var e=document.getElementById('debug');if(e)e.innerHTML=D.slice(-80).join('\n');}
function eventMeta(t){return{color:t==='userLock'?'#e65100':t==='userLogout'?'#888':'#2e7d32',label:t==='userLock'?'Bloqueado':t==='userLogout'?'Offline':'Online',endLabel:t==='userLogin'?'<b>Agora</b>':t==='userUnlock'?'<b>Agora</b>':''};}
function fmtDate(d){var x=new Date(d);if(isNaN(x))return'—';var m=x.getMonth()+1,day=x.getDate();return (day<10?'0':'')+day+'/'+(m<10?'0':'')+m+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtShort(d){var x=new Date(d);if(isNaN(x))return'—';return (x.getDate()<10?'0':'')+x.getDate()+'/'+(x.getMonth()+1<10?'0':'')+(x.getMonth()+1)+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtDur(ms){if(ms<0)ms=0;var m=Math.floor(ms/60000),h=Math.floor(m/60),d=Math.floor(h/24);m%=60;h%=24;if(d>0)return d+'d '+h+'h';if(h>0)return h+'h '+m+'m';return m+'m';}
function ymd(d){var x=new Date(d),m=x.getMonth()+1,day=x.getDate();return x.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(day<10?'0':'')+day;}
function colorFor(k){var h=0,s=String(k||'');for(var i=0;i<s.length;i++)h=((h<<5)-h)+s.charCodeAt(i)|0;return ['#003366','#1565c0','#2e7d32','#6a1b9a','#00838f','#ef6c00','#c62828','#455a64','#5d4037','#283593'][Math.abs(h)%10];}
function splitUser(u){var p=String(u||'').split('\\');return p.length>1?{d:p[0],u:p[1]}:{d:'',u:u||''};}
function setRange(kind,btn){
  document.querySelectorAll('.btn-chip[data-r]').forEach(function(b){b.classList.remove('active');});
  if(btn)btn.classList.add('active');var end=new Date(),start=new Date();
  if(kind==='1h'){start.setTime(end.getTime()-3600000);}
  else if(kind==='2h'){start.setTime(end.getTime()-7200000);}
  else if(kind==='4h'){start.setTime(end.getTime()-14400000);}
  else if(kind==='6h'){start.setTime(end.getTime()-21600000);}
  else if(kind==='8h'){start.setTime(end.getTime()-28800000);}
  else if(kind==='today'){start=new Date(end.getFullYear(),end.getMonth(),end.getDate());}
  else if(kind==='7d'){start.setDate(end.getDate()-6);}else if(kind==='30d'){start.setDate(end.getDate()-29);}
  else if(kind==='month'){start=new Date(end.getFullYear(),end.getMonth(),1);}
  document.getElementById('dStart').value=ymd(start);document.getElementById('dEnd').value=ymd(end);
  loadTimeline();
}
function loadDeviceNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getDeviceNames'});}
function renderDeviceNames(list){
  _allDevices=(list||[]).slice().sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
  document.getElementById('sDevices').textContent=_allDevices.length;
  _allDevices.forEach(function(d){if(selectedDevs[d.nodeid]===undefined)selectedDevs[d.nodeid]=true;});
  _populateXrefDevs(_allDevices);
}
function loadTimeline(){
  var u=document.getElementById('xrefUser').value,d=document.getElementById('xrefDev').value;
  if(u)loadXrefUser();else if(d)loadXrefDev();
}
function buildSessions(events,rs,re){
  var by={};
  events.slice().sort(function(a,b){return new Date(a.detectedAt)-new Date(b.detectedAt);}).forEach(function(e){
    var k=e.nodeid+'|'+(e.displayUser||e.username||'?');
    if(!by[k])by[k]={nodeid:e.nodeid,nodeName:e.nodeName,user:e.username,display:e.displayUser||e.username,events:[]};by[k].events.push(e);
  });
  var out=[];Object.keys(by).forEach(function(k){
    var g=by[k],start=null,state='offline';
    g.events.forEach(function(e){
      var t=new Date(e.detectedAt).getTime();
      if(e.eventType==='userLogin'){
        if(start!=null)out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:start,end:t,state:state});
        start=t;state='login';
      }else if(e.eventType==='userLock'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:start,end:t,state:state});}
        start=t;state='lock';
      }else if(e.eventType==='userUnlock'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:start,end:t,state:state});}
        start=t;state='unlock';
      }else if(e.eventType==='userLogout'){
        if(start!=null){out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:start,end:t,state:state});start=null;}
        else out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:Math.max(rs,t-30*60000),end:t,state:'logout'});
      }
    });if(start!=null)out.push({nodeName:g.nodeName,nodeid:g.nodeid,user:g.user,display:g.display,start:start,end:Math.min(re,Date.now()),state:state,open:true});
  });return out;
}
function _renderGantt(events,rs,re,pwrMap){
  _savedEvents=events;_savedRange={rs:rs,re:re};
  if(!_selectedRange)_fullRange={rs:rs,re:re};
  document.getElementById('sEvents').textContent=events.length;
  var total=re-rs,sessions=buildSessions(events,rs,re),dayMs=86400000,span=total/dayMs;
  var step=span<=0.02?60000:(span<=0.08?300000:(span<=0.25?900000:(span<=0.5?1800000:(span<=1?3600000:(span<=7?10800000:(span<=14?21600000:43200000))))));
  var ticks=[],t0=Math.ceil(rs/step)*step;
  for(var t=t0;t<=re;t+=step){var d=new Date(t);ticks.push({pct:((t-rs)/total)*100,label:step<3600000?((d.getHours()<10?'0':'')+d.getHours()+':'+(d.getMinutes()<10?'0':'')+d.getMinutes()):step<dayMs?((d.getHours()<10?'0':'')+d.getHours()+':00'):((d.getDate()<10?'0':'')+d.getDate()+'/'+(d.getMonth()+1<10?'0':'')+(d.getMonth()+1))});}
  var mw=Math.max(720,Math.min(3600,Math.floor(span*120)));
  var h='<div class="gantt-wrap"><div style="display:flex;border-bottom:1px solid #aaa;background:#e4e9e7;position:sticky;top:0;z-index:2"><div style="width:110px;flex-shrink:0;padding:6px 8px;font-size:10px;color:#333;font-weight:700;border-right:1px solid #aaa">DISPOSITIVO</div><div style="flex:1;position:relative;height:28px;min-width:'+mw+'px">';
  ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"><span style="position:absolute;top:6px;left:3px;font-size:8px;color:#666;white-space:nowrap">'+esc(tk.label)+'</span></div>';});
  h+='</div></div>';
  var byDev={};sessions.forEach(function(s){var n=s.nodeName||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};byDev[n].sessions.push(s);});
  events.forEach(function(e){var n=e.nodeName||e.nodeid||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};});
  var names=Object.keys(byDev).sort();
  names.forEach(function(name){
    var dev=byDev[name];
    // Agrupa sessoes por usuario
    var byU={};dev.sessions.forEach(function(s){var k=s.display||s.user||'?';if(!byU[k])byU[k]=[];byU[k].push(s);});
    var uNames=Object.keys(byU).sort();
    var rowH=Math.max(38,10+uNames.length*22);
    h+='<div style="display:flex;min-height:'+rowH+'px;border-bottom:1px solid #e0e0e0"><div style="width:110px;flex-shrink:0;padding:7px 8px;border-right:1px solid #ccc;font-size:11px;color:#003366;font-weight:700;display:flex;align-items:center;background:#fff">'+esc(name)+'</div><div style="flex:1;position:relative;min-width:'+mw+'px;min-height:'+rowH+'px">';
    ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"></div>';});
    uNames.forEach(function(un,ui){
      var segs=byU[un];if(!segs.length)return;
      segs.sort(function(a,b){return a.start-b.start;});
      var fst=segs[0],lst=segs[segs.length-1];
      var barLeft=Math.max(0,((fst.start-rs)/total)*100),barRight=Math.min(100,((lst.end-rs)/total)*100);if(barRight<=barLeft)barRight=barLeft+0.2;
      var barW=barRight-barLeft,isOpen=segs.some(function(s){return s.open;}),topPos=8+ui*22;
      h+='<div style="position:absolute;top:'+topPos+'px;height:18px;left:'+barLeft+'%;width:'+barW+'%;border-radius:2px;overflow:hidden;display:flex;border:'+(isOpen?'2px dashed':'1px solid')+' rgba(0,0,0,.2)">';
      segs.forEach(function(s){
        var sLeft=Math.max(0,((s.start-rs)/total)*100),sRight=Math.min(100,((s.end-rs)/total)*100);if(sRight<=sLeft)sRight=sLeft+0.2;
        var pct=((sRight-sLeft)/barW)*100;if(pct<0.25)pct=0.25;
        var em2=eventMeta(s.state==='lock'?'userLock':s.state==='unlock'?'userUnlock':s.state==='login'?'userLogin':'userLogout');
        var tt='Usuário: '+esc(s.user||s.display)+'\nDe: '+fmtDate(s.start)+'\nAté: '+fmtDate(s.end)+'\nEstado: '+em2.label+'\nDuração: '+fmtDur(s.end-s.start);
        h+='<div style="height:100%;width:'+pct+'%;background:'+segColor(s.state,s.open)+';border-right:1px solid rgba(0,0,0,.15);min-width:2px" title="'+esc(tt)+'" ondblclick="event.stopPropagation();_selectedRange={rs:'+s.start+',re:'+s.end+'};loadTimeline()"></div>';
      });
      h+='<span style="position:absolute;top:1px;left:3px;font-size:8px;font-weight:700;color:#fff;text-shadow:0 0 2px rgba(0,0,0,.6);pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100% - 6px)" title="'+esc(segs[0].user||'')+'">'+esc(segs[0].user||'')+'</span>';
      h+='</div>';
    });
    h+='</div></div>';
  });
  h+='</div>';document.getElementById('gantt').innerHTML=h;
  setupGanttDrag();
}
function renderTimeline(events,pwrMap){events=events||[];
  if(!events.length){document.getElementById('gantt').innerHTML='<div class="empty">Nenhum evento no período.</div>';return;}
  var rs,re;
  if(_selectedRange){rs=_selectedRange.rs;re=_selectedRange.re;}
  else{
    rs=new Date(document.getElementById('dStart').value+'T00:00:00').getTime();
    re=new Date(document.getElementById('dEnd').value+'T23:59:59.999').getTime();
  }
  if(isNaN(rs)||isNaN(re)||re<=rs){rs=Infinity;re=-Infinity;events.forEach(function(e){var t=new Date(e.detectedAt).getTime();if(t<rs)rs=t;if(t>re)re=t;});if(re<=rs)re=rs+86400000;}
  _renderGantt(events,rs,re,pwrMap);
}
function setupGanttDrag(){
  var wrap=document.querySelector('.gantt-wrap');if(!wrap)return;
  var sel=null,ov=null;
  function getPct(e){
    var wrap=document.querySelector('.gantt-wrap');if(!wrap)return 0;
    var tickArea=wrap.querySelector('[style*="min-width"]');
    if(!tickArea)return 0;
    var taRect=tickArea.getBoundingClientRect();
    var cw=tickArea.offsetWidth;
    var x=e.clientX-taRect.left;
    return Math.max(0,Math.min(100,(x/cw)*100));
  }
  function stopDrag(){
    if(ov){ov.remove();ov=null;}
    if(sel&&_fullRange){
      var total=_fullRange.re-_fullRange.rs,pctStart=Math.min(sel.s,sel.e),pctEnd=Math.max(sel.s,sel.e);
      if(pctEnd-pctStart>0.5){
        var newRs=_fullRange.rs+total*pctStart/100,newRe=_fullRange.rs+total*pctEnd/100;
        _selectedRange={rs:newRs,re:newRe};
        document.getElementById('tlFilter').textContent=new Date(newRs).toLocaleTimeString()+' → '+new Date(newRe).toLocaleTimeString()+' ('+fmtDur(newRe-newRs)+')';
        var u=document.getElementById('xrefUser').value,d=document.getElementById('xrefDev').value;
        if(u)loadXrefUser();else if(d)loadXrefDev();
      }
    }
    sel=null;
  }
  wrap.addEventListener('mousedown',function(e){if(e.button!==0)return;var p=getPct(e);sel={s:p,e:p};if(!ov){ov=document.createElement('div');ov.style.cssText='position:absolute;top:0;bottom:0;background:rgba(0,51,102,.15);pointer-events:none;z-index:5';wrap.appendChild(ov);}});
  wrap.addEventListener('mousemove',function(e){if(!sel)return;sel.e=getPct(e);var l=Math.min(sel.s,sel.e),r=Math.max(sel.s,sel.e);if(ov){ov.style.left=l+'%';ov.style.width=(r-l)+'%';}});
  wrap.addEventListener('mouseup',stopDrag);
  wrap.addEventListener('mouseleave',stopDrag);
}
function loadUserNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getUserNames'});}
function renderUserNames(list){
  _allUsers=(list||[]).slice().sort(function(a,b){return String(a.displayUser||a.username).localeCompare(String(b.displayUser||b.username));});
  document.getElementById('sUsers').textContent=_allUsers.length;
  var sel=document.getElementById('xrefUser');sel.innerHTML='<option value="">— Selecione um usuário —</option>';
  _allUsers.forEach(function(u){var opt=document.createElement('option');opt.value=(u.username||u.displayUser);opt.textContent=(u.displayUser||u.username);sel.appendChild(opt);});
}
function _populateXrefDevs(list){
  var devSel=document.getElementById('xrefDev');devSel.innerHTML='<option value="">— Selecione um dispositivo —</option>';
  list.sort(function(a,b){return String(a.name).localeCompare(String(b.name));}).forEach(function(d){var opt=document.createElement('option');opt.value=d.nodeid;opt.textContent=d.name;devSel.appendChild(opt);});
}
function gotoDev(nid){document.getElementById('xrefDev').value=nid;loadXrefDev();}
function gotoUser(displayUser){
  var sel=document.getElementById('xrefUser');
  for(var i=0;i<sel.options.length;i++){if(sel.options[i].textContent===displayUser||sel.options[i].value===displayUser){sel.selectedIndex=i;loadXrefUser();return;}}
}
function resetUserFilter(){
  _selectedRange=null;_fullRange=null;
  document.getElementById('xrefUser').value='';document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';
  document.getElementById('hintUser').textContent='';_populateXrefDevs(_allDevices);
  document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';document.getElementById('hintDev').textContent='';
  document.getElementById('tlFilter').textContent='';document.getElementById('gantt').innerHTML='<div class="empty">Selecione um usuário ou dispositivo.</div>';
}
function resetDevFilter(){
  _selectedRange=null;_fullRange=null;
  document.getElementById('xrefDev').value='';document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';
  document.getElementById('hintDev').textContent='';_populateXrefDevs(_allDevices);
  document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';document.getElementById('hintUser').textContent='';
  var sel=document.getElementById('xrefUser');sel.innerHTML='<option value="">— Selecione um usuário —</option>';
  _allUsers.forEach(function(u){var opt=document.createElement('option');opt.value=(u.username||u.displayUser);opt.textContent=(u.displayUser||u.username);sel.appendChild(opt);});
  document.getElementById('tlFilter').textContent='';document.getElementById('gantt').innerHTML='<div class="empty">Selecione um usuário ou dispositivo.</div>';
}
function loadXrefUser(){
  var u=document.getElementById('xrefUser').value;if(!u){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';return;}
  document.getElementById('xrefUserResult').innerHTML='<div class="loading">Buscando...</div>';document.getElementById('hintUser').textContent='';
  _xrefPending='user';document.getElementById('gantt').innerHTML='<div class="loading">Carregando...</div>';
  document.getElementById('tlFilter').textContent='Usuário: '+esc(u);
  var sd=_selectedRange||{},rs=sd.rs||(new Date(document.getElementById('dStart').value+'T00:00:00').getTime()),re=sd.re||(new Date(document.getElementById('dEnd').value+'T23:59:59.999').getTime());
  if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',username:u,startDate:new Date(rs).toISOString(),endDate:new Date(re).toISOString(),limit:8000});
}
function loadXrefDev(){
  var n=document.getElementById('xrefDev').value;if(!n){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';return;}
  document.getElementById('xrefDevResult').innerHTML='<div class="loading">Buscando...</div>';document.getElementById('hintDev').textContent='';
  _xrefPending='dev';document.getElementById('gantt').innerHTML='<div class="loading">Carregando...</div>';
  document.getElementById('tlFilter').textContent='Dispositivo: '+esc(document.getElementById('xrefDev').options[document.getElementById('xrefDev').selectedIndex].text);
  var sd=_selectedRange||{},rs=sd.rs||(new Date(document.getElementById('dStart').value+'T00:00:00').getTime()),re=sd.re||(new Date(document.getElementById('dEnd').value+'T23:59:59.999').getTime());
  if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',nodeid:n,startDate:new Date(rs).toISOString(),endDate:new Date(re).toISOString(),limit:8000});
}
function renderXrefUser(e){e=e||[];document.getElementById('sEvents').textContent=e.length;if(!e.length){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Nenhum evento encontrado.</div>';return;}
  var by={};e.forEach(function(v){var n=v.nodeName||v.nodeid||'?';if(!by[n])by[n]={name:n,nodeid:v.nodeid,events:[]};by[n].events.push(v);});
  var names=Object.keys(by).sort();document.getElementById('hintUser').textContent=e.length+' eventos em '+names.length+' dispositivos';
  var h='<div class="stacked">';names.forEach(function(n){var evs=by[n].events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);}),last=evs[0],first=evs[evs.length-1],em=eventMeta(last.eventType);h+='<div class="scard" style="cursor:pointer" onclick="gotoDev(\''+esc(by[n].nodeid)+'\')"><div style="flex:1"><div class="tag">'+esc(n)+'</div><div class="tagl">'+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(em.endLabel||fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+em.color+'">'+em.label+'</span></div>';});
  h+='</div>';document.getElementById('xrefUserResult').innerHTML=h;
  // Se usuario selecionado, filtra dispositivos relacionados
  if(document.getElementById('xrefUser').value){
    var devSel=document.getElementById('xrefDev');var curVal=devSel.value;devSel.innerHTML='<option value="">— Relacionados —</option>';
    names.forEach(function(n){var d=by[n];var opt=document.createElement('option');opt.value=d.nodeid;opt.textContent=n;if(d.nodeid===curVal)opt.selected=true;devSel.appendChild(opt);});
  }
}
function renderXrefDev(e){e=e||[];document.getElementById('sEvents').textContent=e.length;if(!e.length){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Nenhum evento encontrado.</div>';return;}
  var by={};e.forEach(function(v){var u=v.displayUser||v.username||'?';if(!by[u])by[u]={user:u,domain:v.domain,events:[]};by[u].events.push(v);});
  var names=Object.keys(by).sort();document.getElementById('hintDev').textContent=e.length+' eventos de '+names.length+' usuários';
  var h='<div class="stacked">';names.forEach(function(u){var g=by[u],evs=g.events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);}),last=evs[0],first=evs[evs.length-1],un=splitUser(g.user),em=eventMeta(last.eventType);var _gud=esc((un.user||g.user).replace(/\\/g,'\\\\'));h+='<div class="scard" style="cursor:pointer" onclick="gotoUser(\''+_gud+'\')"><div style="flex:1"><div class="tag">'+esc(un.user||g.user)+'</div><div class="tagl">'+(g.domain?esc(g.domain)+' · ':'')+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(em.endLabel||fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+em.color+'">'+em.label+'</span></div>';});
  h+='</div>';document.getElementById('xrefDevResult').innerHTML=h;
  // Se dispositivo selecionado, filtra usuarios relacionados
  if(document.getElementById('xrefDev').value){
    var usrSel=document.getElementById('xrefUser');var curVal=usrSel.value;usrSel.innerHTML='<option value="">— Relacionados —</option>';
    names.forEach(function(u){var g=by[u];var un=splitUser(g.user);var opt=document.createElement('option');opt.value=(un.user||g.user);opt.textContent=(g.domain?g.domain+'\\':'')+(un.user||g.user);if((un.user||g.user)===curVal)opt.selected=true;usrSel.appendChild(opt);});
  }
}
(function(){
  // pluginHandler registration (MeshCentral chama na inicialização, ignoramos se for meshserver obj)
  try{
    var ph=(top&&top.pluginHandler&&top.pluginHandler.usertracer)||(parent&&parent.pluginHandler&&parent.pluginHandler.usertracer);
    if(ph){
      ph.timeline=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','timeline n='+m.data.length);try{if(_xrefPending==='user'){renderXrefUser(m.data);_xrefPending='';}else if(_xrefPending==='dev'){renderXrefDev(m.data);_xrefPending='';}else _xrefPending='';}catch(ex2){dlog('PH_XREF_ERR',ex2.message);_xrefPending='';}renderTimeline(m.data,m._pwrMap);}else dlog('PHSKIP','timeline',typeof m);};
      ph.deviceNames=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','deviceNames n='+m.data.length);renderDeviceNames(m.data);}else dlog('PHSKIP','deviceNames',typeof m);};
      ph.userNames=function(m){if(m&&m.data&&Array.isArray(m.data)){dlog('PHOK','userNames n='+m.data.length);renderUserNames(m.data);}else dlog('PHSKIP','userNames',typeof m);};
      dlog('PH','registered');
    }
  }catch(e){dlog('PHE','err',e.message);}
  // WebSocket handler robusto
  if(ms&&ms.socket){
    var ws=ms.socket,did=false;
    var handler=function(e){
      try{var d=JSON.parse(e.data);if(d.action==='plugin'&&d.plugin==='usertracer'){
        dlog('WS',d.method,Array.isArray(d.data)?('n='+d.data.length):typeof d.data);
        if(d.method==='deviceNames')renderDeviceNames(d.data||[]);
        else if(d.method==='userNames')renderUserNames(d.data||[]);
        else if(d.method==='timeline'){
          try{
            if(_xrefPending==='user'){renderXrefUser(d.data||[]);_xrefPending='';}
            else if(_xrefPending==='dev'){renderXrefDev(d.data||[]);_xrefPending='';}else _xrefPending='';
          }catch(ex2){dlog('WS_XREF_ERR',ex2.message);_xrefPending='';}
          renderTimeline(d.data||[],d._pwrMap);
        }
      }}catch(ex){}
    };
    try{ws.addEventListener('message',handler);did=true;}catch(ex){dlog('WSE','addEventListener',ex.message);}
    if(!did||ws.onmessage!==handler){var old=ws.onmessage;ws.onmessage=function(ev){handler(ev);if(typeof old==='function')old.call(ws,ev);};}dlog('WS','installed');
  } else {dlog('WS','no socket');}
})();
var _d=new Date();document.getElementById('dStart').value=ymd(new Date(_d.getTime()-28800000));document.getElementById('dEnd').value=ymd(_d);
loadDeviceNames();loadUserNames();
</script>
