<html>
<head>
<meta charset="utf-8">
<title>User Tracer</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Trebuchet MS",Arial,Helvetica,sans-serif;background:#d3d9d6;color:#000;padding:12px;font-size:13px;line-height:1.35}
.header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.header h1{font-size:18px;font-weight:700;color:#003366}
.header .sub{color:#444;font-size:12px;margin-top:2px}
.stats{display:flex;gap:6px;flex-wrap:wrap}
.stat{background:#fff;border:1px solid #aaa;border-radius:3px;padding:8px 12px;min-width:88px}
.stat .n{font-size:18px;font-weight:700;color:#003366}
.stat .l{font-size:10px;color:#666;text-transform:uppercase;margin-top:1px}
.panel{background:#fff;border:1px solid #aaa;border-radius:3px;padding:10px;margin-bottom:10px}
.panel-title{background:#c0c0c0;color:#000;font-size:12px;font-weight:700;padding:5px 8px;margin:-10px -10px 10px -10px;border-bottom:1px solid #aaa}
.toolbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.toolbar label{font-size:11px;color:#444;font-weight:700}
.toolbar select,.toolbar input{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px}
.btn{font-family:inherit;font-size:12px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:5px 12px;border-radius:2px;cursor:pointer}
.btn:hover{background:#e4e4e4}
.btn-primary{background:#003366;color:#fff;border-color:#002244}
.btn-primary:hover{background:#004080}
.btn-live{background:#c62828;color:#fff;border-color:#a02121;font-weight:700}
.btn-live.active{background:#2e7d32;border-color:#1b5e20}
.btn-chip{background:#ddd;border:1px solid #aaa;color:#333;padding:4px 10px;font-size:11px}
.btn-chip.active{background:#003366;color:#fff;border-color:#003366;font-weight:700}
.loading{text-align:center;padding:28px;color:#666}
.muted{color:#666;font-size:11px}
.empty{text-align:center;padding:36px 16px;color:#666;background:#fff}
.xref-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.xref-grid .col{min-width:0}
@media(max-width:768px){.xref-grid{grid-template-columns:1fr}}
.stacked{display:flex;gap:8px;flex-direction:column;max-height:320px;overflow-y:auto;padding-right:4px}
.stacked .scard{display:flex;gap:8px;align-items:center;padding:8px 10px;background:#f7f8f7;border:1px solid #ddd;border-radius:2px}
.stacked .scard:hover{border-color:#003366;background:#eef3f8}
.scard .tag{font-weight:700;color:#003366;font-size:12px;flex:1}
.scard .tagl{color:#555;font-size:11px}
.scard .badge{font-size:10px;color:#666;background:#eee;padding:2px 6px;border-radius:999px}
#dbgToggle{cursor:pointer;font-size:11px;color:#003366;user-select:none;margin-top:10px;text-decoration:underline}
#debug{display:none;background:#fff8e1;border:1px solid #e0c060;color:#333;padding:6px;margin-top:4px;font-size:10px;font-family:Consolas,monospace;max-height:140px;overflow:auto;border-radius:2px;white-space:pre-wrap}
.chips{display:flex;flex-wrap:wrap;gap:5px;max-height:80px;overflow:auto;padding:2px}
.chip{display:inline-flex;align-items:center;gap:5px;background:#eee;border:1px solid #bbb;border-radius:12px;padding:3px 9px;font-size:11px;cursor:pointer;user-select:none;color:#222}
.chip:hover{background:#e4e9e7}
.chip.sel{background:#003366;border-color:#003366;color:#fff}
.chip .dot{width:7px;height:7px;border-radius:50%;background:#999}
.chip.sel .dot{background:#7ec8ff}
.gantt-wrap{overflow:auto;border:1px solid #aaa;background:#fff;position:relative}
.gantt-now{position:absolute;top:0;bottom:0;width:2px;background:#c62828;z-index:10;pointer-events:none;box-shadow:0 0 4px rgba(198,40,40,.5)}
.sess-click{cursor:pointer}
.detail-panel{background:#f7f8f7;border:1px solid #bbb;border-radius:2px;padding:8px;margin-top:6px;display:none}
.detail-panel .dp-title{font-weight:700;color:#003366;font-size:12px;margin-bottom:4px}
.detail-panel table{width:100%;font-size:11px}
.detail-panel td{padding:2px 6px;border-bottom:1px solid #eee}
.detail-panel .lbl{color:#666;font-weight:700;width:80px}
</style>
</head>
<body>
<div class="header">
  <div><h1>User Tracer</h1><div class="sub">Lastro AD · cruzamento · timeline ao vivo</div></div>
  <div class="stats">
    <div class="stat"><div class="n" id="sDevices">—</div><div class="l">Dispositivos</div></div>
    <div class="stat"><div class="n" id="sUsers">—</div><div class="l">Usuários</div></div>
    <div class="stat"><div class="n" id="sEvents">—</div><div class="l">Eventos</div></div>
  </div>
</div>

<div class="panel">
  <div class="panel-title">Timeline ao vivo</div>
  <div class="toolbar">
    <button class="btn btn-chip" data-r="today" onclick="setRange('today',this)">Hoje</button>
    <button class="btn btn-chip active" data-r="7d" onclick="setRange('7d',this)">7 dias</button>
    <button class="btn btn-chip" data-r="30d" onclick="setRange('30d',this)">30 dias</button>
    <button class="btn btn-chip" data-r="month" onclick="setRange('month',this)">Este mês</button>
    <label style="margin-left:6px">De</label><input type="date" id="dStart"><label>Até</label><input type="date" id="dEnd">
    <button class="btn btn-primary" onclick="loadTimeline()">Aplicar</button>
    <button class="btn btn-live" id="liveBtn" onclick="toggleLive()">🔴 Ao Vivo</button>
    <span class="muted" id="liveHint"></span>
  </div>
  <div class="toolbar" style="margin-bottom:6px">
    <button class="btn" onclick="selectAllDevs(true)">Todos dispositivos</button>
    <button class="btn" onclick="selectAllDevs(false)">Nenhum</button>
    <input type="text" id="devSearch" placeholder="filtrar..." style="width:160px" oninput="filterDevChips()">
    <span class="muted" id="tlHint"></span>
  </div>
  <div class="chips" id="devChips"><span class="muted">Carregando...</span></div>
  <div id="gantt"><div class="empty">Selecione período e dispositivos, clique Aplicar.</div></div>
  <div id="detailPanel" class="detail-panel"></div>
</div>

<div class="xref-grid">
  <div class="col">
    <div class="panel">
      <div class="panel-title">Usuário → Dispositivos</div>
      <div class="toolbar">
        <select id="xrefUser" style="flex:1" onchange="loadXrefUser()"><option value="">— Selecione um usuário —</option></select>
        <button class="btn btn-primary" onclick="loadXrefUser()">Buscar</button>
        <span class="muted" id="hintUser"></span>
      </div>
      <div id="xrefUserResult"><div class="empty">Selecione um usuário.</div></div>
    </div>
  </div>
  <div class="col">
    <div class="panel">
      <div class="panel-title">Dispositivo → Usuários</div>
      <div class="toolbar">
        <select id="xrefDev" style="flex:1" onchange="loadXrefDev()"><option value="">— Selecione um dispositivo —</option></select>
        <button class="btn btn-primary" onclick="loadXrefDev()">Buscar</button>
        <span class="muted" id="hintDev"></span>
      </div>
      <div id="xrefDevResult"><div class="empty">Selecione um dispositivo.</div></div>
    </div>
  </div>
</div>

<div id="dbgToggle" onclick="var e=document.getElementById('debug');e.style.display=e.style.display==='none'?'block':'none'">Debug</div>
<div id="debug">aguardando...</div>

<script>
var D=[], ms=(typeof parent!=='undefined'&&parent.meshserver)||window.meshserver;
var _allDevices=[], _allUsers=[], _xrefPending='', selectedDevs={};
var _live=false, _refreshTimer=null, _zoomLevel=0, _savedEvents=[], _savedRange={rs:0,re:0};
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function dlog(){var a=Array.prototype.slice.call(arguments);D.push(new Date().toLocaleTimeString()+' '+a.join(' '));var e=document.getElementById('debug');if(e)e.innerHTML=D.slice(-80).join('\n');}
function splitUser(u){var p=String(u||'').split('\\');return p.length>1?{domain:p[0],user:p[1]}:{domain:'',user:u||''};}
function fmtDate(d){var x=new Date(d);if(isNaN(x))return'—';var m=x.getMonth()+1,day=x.getDate();return (day<10?'0':'')+day+'/'+(m<10?'0':'')+m+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtShort(d){var x=new Date(d);if(isNaN(x))return'—';return (x.getDate()<10?'0':'')+x.getDate()+'/'+(x.getMonth()+1<10?'0':'')+(x.getMonth()+1)+' '+x.getHours()+':'+(x.getMinutes()<10?'0':'')+x.getMinutes();}
function fmtDur(ms){if(ms<0)ms=0;var m=Math.floor(ms/60000),h=Math.floor(m/60),d=Math.floor(h/24);m%=60;h%=24;if(d>0)return d+'d '+h+'h';if(h>0)return h+'h '+m+'m';return m+'m';}
function ymd(d){var x=new Date(d),m=x.getMonth()+1,day=x.getDate();return x.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(day<10?'0':'')+day;}
function colorFor(k){var h=0,s=String(k||'');for(var i=0;i<s.length;i++)h=((h<<5)-h)+s.charCodeAt(i)|0;return ['#003366','#1565c0','#2e7d32','#6a1b9a','#00838f','#ef6c00','#c62828','#455a64','#5d4037','#283593'][Math.abs(h)%10];}
function setRange(kind,btn){
  document.querySelectorAll('.btn-chip[data-r]').forEach(function(b){b.classList.remove('active');});
  if(btn)btn.classList.add('active');
  var end=new Date(),start=new Date();
  if(kind==='today'){start=new Date(end.getFullYear(),end.getMonth(),end.getDate());}
  else if(kind==='7d'){start.setDate(end.getDate()-6);}
  else if(kind==='30d'){start.setDate(end.getDate()-29);}
  else if(kind==='month'){start=new Date(end.getFullYear(),end.getMonth(),1);}
  document.getElementById('dStart').value=ymd(start);document.getElementById('dEnd').value=ymd(end);
  _zoomLevel=0;
}
function toggleLive(){
  _live=!_live;
  var btn=document.getElementById('liveBtn');
  if(_live){
    btn.textContent='🟢 Ao Vivo';btn.classList.add('active');
    setRange('today',document.querySelector('.btn-chip[data-r="today"]'));
    loadTimeline();
    _refreshTimer=setInterval(loadTimeline,30000);
    document.getElementById('liveHint').textContent='atualizando a cada 30s';
  } else {
    btn.textContent='🔴 Ao Vivo';btn.classList.remove('active');
    if(_refreshTimer){clearInterval(_refreshTimer);_refreshTimer=null;}
    document.getElementById('liveHint').textContent='';
  }
}

// ---- Device chips ----
function loadDeviceNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getDeviceNames'});}
function renderDeviceNames(list){
  _allDevices=(list||[]).slice().sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
  document.getElementById('sDevices').textContent=_allDevices.length;
  _allDevices.forEach(function(d){if(!selectedDevs[d.nodeid]&&selectedDevs[d.nodeid]!==false)selectedDevs[d.nodeid]=true;});
  _populateXrefDevs(_allDevices);
  renderDevChips();
}
function renderDevChips(){
  var q=(document.getElementById('devSearch').value||'').toLowerCase().trim();
  var h='';
  _allDevices.forEach(function(d){
    if(q&&String(d.name).toLowerCase().indexOf(q)<0)return;
    var on=selectedDevs[d.nodeid];
    h+='<div class="chip'+(on?' sel':'')+'" data-id="'+esc(d.nodeid)+'" onclick="toggleDev(this)"><span class="dot"></span>'+esc(d.name)+'</div>';
  });
  document.getElementById('devChips').innerHTML=h||'<span class="muted">Nenhum dispositivo.</span>';
}
function filterDevChips(){renderDevChips();}
function toggleDev(el){
  var id=el.getAttribute('data-id');
  if(selectedDevs[id])delete selectedDevs[id];else selectedDevs[id]=true;
  el.classList.toggle('sel',!!selectedDevs[id]);
}
function selectAllDevs(yes){
  selectedDevs={};
  if(yes)_allDevices.forEach(function(d){selectedDevs[d.nodeid]=true;});
  renderDevChips();
}

// ---- Timeline Gantt ----
function loadTimeline(){
  var s=document.getElementById('dStart').value,e=document.getElementById('dEnd').value;
  if(!s||!e){document.getElementById('gantt').innerHTML='<div class="empty">Selecione datas.</div>';return;}
  var ids=[];Object.keys(selectedDevs).forEach(function(k){if(selectedDevs[k])ids.push(k);});
  if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',startDate:s+'T00:00:00',endDate:e+'T23:59:59.999',nodeids:ids,limit:8000});
}
function onGanttWheel(ev){
  if(!_savedEvents.length)return;
  ev.preventDefault();
  var dir=ev.deltaY<0?-1:1;
  _zoomLevel+=dir;
  if(_zoomLevel<-10)_zoomLevel=-10;if(_zoomLevel>10)_zoomLevel=10;
  var factor=1+_zoomLevel*0.15;if(factor<0.15)factor=0.15;
  var mid=(_savedRange.rs+_savedRange.re)/2;
  var half=(_savedRange.re-_savedRange.rs)/(2*factor);
  var newRs=Math.max(mid-half,0),newRe=Math.min(mid+half,Date.now());
  if(newRe-newRs<60000)return;
  _savedRange.rs=newRs;_savedRange.re=newRe;
  var dStart=new Date(newRs),dEnd=new Date(newRe);
  document.getElementById('dStart').value=ymd(dStart);document.getElementById('dEnd').value=ymd(dEnd);
  _renderGantt(_savedEvents,newRs,newRe);
}
function onSessClick(display,user,start,end,open){
  var p=document.getElementById('detailPanel');
  p.innerHTML='<div class="dp-title">'+esc(display||user)+'</div><table>'
    +'<tr><td class="lbl">Início</td><td>'+fmtDate(start)+'</td></tr>'
    +'<tr><td class="lbl">Término</td><td>'+(open?'<b style="color:#2e7d32">Agora</b>':fmtDate(end))+'</td></tr>'
    +'<tr><td class="lbl">Duração</td><td>'+fmtDur(end-start)+'</td></tr>'
    +'</table><div style="margin-top:6px"><button class="btn" onclick="document.getElementById(\'detailPanel\').style.display=\'none\'">Fechar</button></div>';
  p.style.display='block';
}
function buildSessions(events,rs,re){
  var by={};
  events.slice().sort(function(a,b){return new Date(a.detectedAt)-new Date(b.detectedAt);}).forEach(function(e){
    var k=e.nodeid+'|'+(e.displayUser||e.username||'?');
    if(!by[k])by[k]={nodeid:e.nodeid,nodeName:e.nodeName,user:e.username,display:e.displayUser||e.username,events:[]};
    by[k].events.push(e);
  });
  var out=[];
  Object.keys(by).forEach(function(k){
    var g=by[k],open=null;
    g.events.forEach(function(e){
      var t=new Date(e.detectedAt).getTime();
      if(e.eventType==='userLogin'){
        if(open!=null)out.push({nodeName:g.nodeName,user:g.user,display:g.display,start:open,end:t,open:false});
        open=t;
      } else if(e.eventType==='userLogout'){
        if(open!=null){out.push({nodeName:g.nodeName,user:g.user,display:g.display,start:open,end:t,open:false});open=null;}
        else out.push({nodeName:g.nodeName,user:g.user,display:g.display,start:Math.max(rs,t-30*60000),end:t,open:false});
      }
    });
    if(open!=null)out.push({nodeName:g.nodeName,user:g.user,display:g.display,start:open,end:Math.min(re,Date.now()),open:true});
  });
  return out;
}
function _renderGantt(events,rs,re){
  _savedEvents=events;_savedRange={rs:rs,re:re};
  document.getElementById('sEvents').textContent=events.length;
  var total=re-rs;
  var sessions=buildSessions(events,rs,re);
  var dayMs=86400000,hourMs=3600000,span=total/dayMs;
  var step=span<=1?hourMs:(span<=7?hourMs*3:(span<=14?dayMs:dayMs*2));
  var ticks=[],t0=Math.ceil(rs/step)*step;
  for(var t=t0;t<=re;t+=step){
    var d=new Date(t);
    ticks.push({pct:((t-rs)/total)*100,label:step<dayMs?((d.getHours()<10?'0':'')+d.getHours()+':00'):((d.getDate()<10?'0':'')+d.getDate()+'/'+(d.getMonth()+1<10?'0':'')+(d.getMonth()+1))});
  }
  var mw=Math.max(720,Math.min(3600,Math.floor(span*120)));
  var now=Date.now(),nowPct=((now-rs)/total)*100;
  var h='<div class="gantt-wrap" onwheel="onGanttWheel(event)"><div style="display:flex;border-bottom:1px solid #aaa;background:#e4e9e7;position:sticky;top:0;z-index:2"><div style="width:110px;flex-shrink:0;padding:6px 8px;font-size:10px;color:#333;font-weight:700;border-right:1px solid #aaa">DISPOSITIVO</div><div style="flex:1;position:relative;height:28px;min-width:'+mw+'px">';
  ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"><span style="position:absolute;top:6px;left:3px;font-size:8px;color:#666;white-space:nowrap">'+esc(tk.label)+'</span></div>';});
  h+='</div></div>';
  if(nowPct>=0&&nowPct<=100)h+='<div class="gantt-now" style="left:'+nowPct+'%"></div>';
  var byDev={};
  sessions.forEach(function(s){var n=s.nodeName||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};byDev[n].sessions.push(s);});
  events.forEach(function(e){var n=e.nodeName||e.nodeid||'?';if(!byDev[n])byDev[n]={name:n,sessions:[]};});
  var names=Object.keys(byDev).sort();
  names.forEach(function(name){
    var dev=byDev[name];
    h+='<div style="display:flex;min-height:38px;border-bottom:1px solid #e0e0e0"><div style="width:110px;flex-shrink:0;padding:7px 8px;border-right:1px solid #ccc;font-size:11px;color:#003366;font-weight:700;display:flex;align-items:center;background:#fff">'+esc(name)+'</div><div style="flex:1;position:relative;min-width:'+mw+'px;min-height:38px">';
    ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"></div>';});
    dev.sessions.forEach(function(s){
      var left=Math.max(0,((s.start-rs)/total)*100);
      var right=Math.min(100,((s.end-rs)/total)*100);
      if(right<=left)right=left+0.2;
      var w=Math.max(0.25,right-left),c=colorFor(s.display||s.user);
      h+='<div class="sess-click" style="position:absolute;top:8px;height:20px;border-radius:2px;min-width:3px;font-size:9px;font-weight:700;color:#fff;padding:0 4px;display:flex;align-items:center;overflow:hidden;white-space:nowrap;border:'+(s.open?'2px dashed':'1px solid')+' rgba(0,0,0,.2);cursor:pointer;left:'+left+'%;width:'+w+'%;background:'+c+'" onclick="onSessClick(\''+esc(s.display||s.user)+'\',\''+esc(s.user||'')+'\','+s.start+','+s.end+','+s.open+')">'+esc(s.user||'')+'</div>';
    });
    h+='</div></div>';
  });
  h+='</div>';
  document.getElementById('gantt').innerHTML=h;
}
function renderTimeline(events){events=events||[];
  if(!events.length){document.getElementById('gantt').innerHTML='<div class="empty">Nenhum evento no período.</div>';return;}
  var rs=new Date(document.getElementById('dStart').value+'T00:00:00').getTime();
  var re=new Date(document.getElementById('dEnd').value+'T23:59:59.999').getTime();
  if(isNaN(rs)||isNaN(re)||re<=rs){rs=Infinity;re=-Infinity;events.forEach(function(e){var t=new Date(e.detectedAt).getTime();if(t<rs)rs=t;if(t>re)re=t;});if(re<=rs)re=rs+86400000;}
  _renderGantt(events,rs,re);
}

// ---- Cross-reference ----
function loadUserNames(){if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getUserNames'});}
function renderUserNames(list){
  _allUsers=(list||[]).slice().sort(function(a,b){return String(a.displayUser||a.username).localeCompare(String(b.displayUser||b.username));});
  document.getElementById('sUsers').textContent=_allUsers.length;
  var sel=document.getElementById('xrefUser');
  sel.innerHTML='<option value="">— Selecione um usuário —</option>';
  _allUsers.forEach(function(u){
    var opt=document.createElement('option');
    opt.value=(u.username||u.displayUser);opt.textContent=(u.displayUser||u.username);sel.appendChild(opt);
  });
}
function _populateXrefDevs(list){
  var devSel=document.getElementById('xrefDev');
  devSel.innerHTML='<option value="">— Selecione um dispositivo —</option>';
  list.sort(function(a,b){return String(a.name).localeCompare(String(b.name));}).forEach(function(d){
    var opt=document.createElement('option');opt.value=d.nodeid;opt.textContent=d.name;devSel.appendChild(opt);
  });
}
function loadXrefUser(){
  var uname=document.getElementById('xrefUser').value;
  if(!uname){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Selecione um usuário.</div>';return;}
  document.getElementById('xrefUserResult').innerHTML='<div class="loading">Buscando...</div>';
  document.getElementById('hintUser').textContent='';
  _xrefPending='user';if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',username:uname,limit:5000});
}
function loadXrefDev(){
  var nid=document.getElementById('xrefDev').value;
  if(!nid){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Selecione um dispositivo.</div>';return;}
  document.getElementById('xrefDevResult').innerHTML='<div class="loading">Buscando...</div>';
  document.getElementById('hintDev').textContent='';
  _xrefPending='dev';if(ms)ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',nodeid:nid,limit:5000});
}
function renderXrefUser(events){events=events||[];
  document.getElementById('sEvents').textContent=events.length;
  if(!events.length){document.getElementById('xrefUserResult').innerHTML='<div class="empty">Nenhum evento encontrado para este usuário.</div>';return;}
  var byDev={};events.forEach(function(e){var n=e.nodeName||e.nodeid||'?';if(!byDev[n])byDev[n]={name:n,events:[]};byDev[n].events.push(e);});
  var names=Object.keys(byDev).sort();
  document.getElementById('hintUser').textContent=events.length+' eventos em '+names.length+' dispositivos';
  var h='<div class="stacked">';
  names.forEach(function(name){
    var evs=byDev[name].events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);});
    var last=evs[0],first=evs[evs.length-1];
    h+='<div class="scard"><div style="flex:1"><div class="tag">'+esc(name)+'</div><div class="tagl">'+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(last.eventType==='userLogin'?'<b>Agora</b>':fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+(last.eventType==='userLogin'?'#2e7d32':'#888')+'">'+(last.eventType==='userLogin'?'Online':'Offline')+'</span></div>';
  });
  h+='</div>';document.getElementById('xrefUserResult').innerHTML=h;
}
function renderXrefDev(events){events=events||[];
  document.getElementById('sEvents').textContent=events.length;
  if(!events.length){document.getElementById('xrefDevResult').innerHTML='<div class="empty">Nenhum evento encontrado para este dispositivo.</div>';return;}
  var byUser={};events.forEach(function(e){var u=e.displayUser||e.username||'?';if(!byUser[u])byUser[u]={user:u,domain:e.domain,events:[]};byUser[u].events.push(e);});
  var usernames=Object.keys(byUser).sort();
  document.getElementById('hintDev').textContent=events.length+' eventos de '+usernames.length+' usuários';
  var h='<div class="stacked">';
  usernames.forEach(function(u){
    var g=byUser[u],evs=g.events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);});
    var last=evs[0],first=evs[evs.length-1];
    var un=splitUser(g.user);
    h+='<div class="scard"><div style="flex:1"><div class="tag">'+esc(un.user||g.user)+'</div><div class="tagl">'+(g.domain?esc(g.domain)+' · ':'')+evs.length+' eventos · '+fmtDate(first.detectedAt)+' → '+(last.eventType==='userLogin'?'<b>Agora</b>':fmtDate(last.detectedAt))+'</div></div><span class="badge" style="color:'+(last.eventType==='userLogin'?'#2e7d32':'#888')+'">'+(last.eventType==='userLogin'?'Online':'Offline')+'</span></div>';
  });
  h+='</div>';document.getElementById('xrefDevResult').innerHTML=h;
}

// ---- WS ----
if(ms&&ms.socket){
  var orig=ms.socket.onmessage;
  ms.socket.onmessage=function(event){
    try{
      var d=JSON.parse(event.data);
      if(d.action==='plugin'&&d.plugin==='usertracer'){
        dlog('WS',d.method,Array.isArray(d.data)?('n='+d.data.length):typeof d.data);
        if(d.method==='deviceNames')renderDeviceNames(d.data||[]);
        else if(d.method==='userNames')renderUserNames(d.data||[]);
        else if(d.method==='timeline'){
          if(_xrefPending==='user'){renderXrefUser(d.data||[]);_xrefPending='';}
          else if(_xrefPending==='dev'){renderXrefDev(d.data||[]);_xrefPending='';}
          else renderTimeline(d.data||[]);
        }
        return;
      }
    }catch(e){}
    if(typeof orig==='function')orig.call(ms.socket,event);
  };
}
setRange('7d',document.querySelector('.btn-chip[data-r="7d"]'));
document.addEventListener('DOMContentLoaded',function(){loadDeviceNames();loadUserNames();loadTimeline();});
</script>
</body>
